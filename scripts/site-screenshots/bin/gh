#!/bin/sh
# Stand-in for the GitHub CLI: `gh pr view <branch> --json ...` answers with a
# canned PR per branch, so PR segments render the same on every run.
[ "$1 $2" = "pr view" ] || exit 1
url=https://github.com/alxhill/superline/pull
check() { printf '[{"name":"lint","status":"COMPLETED","conclusion":"SUCCESS"},{"name":"test","status":"%s","conclusion":%s}]' "$1" "$2"; }
review() { printf '[{"author":{"login":"octocat"},"state":"%s"}]' "$1"; }
requested='[{"__typename":"User","login":"octocat"}]'
# No review activity unless a branch says otherwise.
decision='' requests='[]' reviews='[]'
case "$3" in
  feat/usage-sparklines) n=142 state=OPEN draft=false checks=$(check COMPLETED '"SUCCESS"') ;;
  feat/draft-themes) n=151 state=OPEN draft=true checks='[]' ;;
  feat/login) n=148 state=OPEN draft=false checks=$(check IN_PROGRESS null)
    decision=REVIEW_REQUIRED requests=$requested ;;
  fix/flaky-test) n=147 state=OPEN draft=false checks=$(check COMPLETED '"FAILURE"')
    decision=CHANGES_REQUESTED reviews=$(review CHANGES_REQUESTED) ;;
  feat/search) n=145 state=OPEN draft=false checks=$(check COMPLETED '"SUCCESS"')
    decision=REVIEW_REQUIRED reviews=$(review COMMENTED) ;;
  feat/badges) n=150 state=OPEN draft=false checks=$(check COMPLETED '"SUCCESS"')
    decision=APPROVED reviews=$(review APPROVED) ;;
  feat/nushell) n=139 state=MERGED draft=false checks=$(check COMPLETED '"SUCCESS"')
    decision=APPROVED reviews=$(review APPROVED) ;;
  *) exit 1 ;;
esac
printf '{"number":%s,"url":"%s/%s","state":"%s","isDraft":%s,"statusCheckRollup":%s,"additions":%s,"deletions":%s,"reviewDecision":"%s","reviewRequests":%s,"latestReviews":%s}\n' \
  "$n" "$url" "$n" "$state" "$draft" "$checks" "$((n * 3))" "$((n / 4))" "$decision" "$requests" "$reviews"
