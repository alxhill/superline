{
  "theme": "example_theme.json",
  "rows": [
    {
      "left": [
        {
          "padding": 2
        },
        {
          "separator": "round"
        },
        "read_only",
        {
          "cwd": {
            "max_length": 60,
            "wanted_seg_num": 5,
            "resolve_symlinks": false
          }
        },
        {
          "padding": 2
        },
        {
          "git": {
            "status_timeout_ms": 250
          }
        },
        { "pr": { "status": true } }
      ],
      "right": []
    },
    {
      "left": [
        "shell",
        {
          "last_cmd_duration": {
            "min_run_time": 50
          }
        },
        "cmd",
        {
          "padding": 1
        }
      ],
      "right": [
        {
          "separator": "round"
        },
        "node",
        "java",
        "python",
        "cargo",
        {
          "ai_usage": {
            "provider": "claude",
            "session": true,
            "weekly": false,
            "display": "bar"
          }
        },
        {
          "ai_usage": {
            "provider": "codex",
            "session": true,
            "weekly": true,
            "display": "sparkline",
            "threshold": 80
          }
        },
        {
          "padding": 0
        }
      ]
    }
  ],
  "update": {
    "disable": false
  }
}
