[
  {
    "name": "status",
    "description": "Success chevron, then a failing command's status below the intact previous prompt",
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}{{sep}}" },
      { "snapshot": "clean" },
      { "run": { "exit": 7 } },
      { "wait": "{{shell}}{{sep}}{{ok}}{{sep}}[^ ]* {{last}}" },
      { "wait": "{{shell}}{{sep}}7{{sep}}" },
      { "snapshot": "failure" }
    ]
  },
  {
    "name": "multiline",
    "description": "Three rows with right sides survive a command and redraw in order",
    "config": {
      "theme": "rainbow",
      "rows": [
        { "left": [{ "text": "row-one" }], "right": [{ "text": "right-one" }, { "padding": 0 }] },
        { "left": [{ "text": "row-two" }], "right": [{ "text": "right-two" }, { "padding": 0 }] },
        { "left": ["shell", "cmd"], "right": [{ "text": "right-three" }, { "padding": 0 }] }
      ]
    },
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "first",
          "expect": ["\\A[^\\n]*row-one[^\\n]*right-one[^\\n]*\\n[^\\n]*row-two[^\\n]*right-two[^\\n]*\\n{{shell}}{{sep}}{{ok}}"],
          "widths": [
            { "line": "right-one|right-two", "width": "{{columns}} - 1" },
            { "line": "right-three", "min": "{{columns}} - 1", "max": "{{columns}}", "shells": ["fish", "zsh", "nu"] }
          ]
        }
      },
      { "run": "echo hello" },
      { "wait": "\\nhello\\n[^\\n]*row-one" },
      {
        "snapshot": {
          "name": "second",
          "expect": [
            "\\A[^\\n]*row-one[^\\n]*right-one[^\\n]*\\n[^\\n]*row-two[^\\n]*right-two[^\\n]*\\n{{shell}}[^\\n]*echo hello[^\\n]*\\nhello\\n[^\\n]*row-one[^\\n]*right-one[^\\n]*\\n[^\\n]*row-two[^\\n]*right-two[^\\n]*\\n{{shell}}{{sep}}{{ok}}",
            { "regex": "\\n{{shell}}{{sep}}{{ok}}{{sep}} +[^\\n]*right-three[^\\n]*\\z", "shells": ["fish", "zsh", "nu"] }
          ],
          "widths": [{ "line": "right-one|right-two", "width": "{{columns}} - 1" }]
        }
      }
    ]
  },
  {
    "name": "widths",
    "description": "Right sides stay flush with the edge at narrow, medium and wide terminals",
    "columns": [40, 80, 160],
    "rows": 6,
    "config": {
      "theme": "rainbow",
      "rows": [
        { "left": [{ "text": "left-top" }], "right": [{ "text": "right-top" }, { "padding": 0 }] },
        { "left": ["shell", "cmd"], "right": [{ "text": "right-bottom" }, { "padding": 0 }] }
      ]
    },
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "prompt",
          "widths": [
            { "line": "right-top", "width": "{{columns}} - 1" },
            { "line": "right-bottom", "min": "{{columns}} - 1", "max": "{{columns}}", "shells": ["fish", "zsh", "nu"] }
          ]
        }
      }
    ]
  },
  {
    "name": "narrow",
    "description": "A row wider than the terminal wraps (or is truncated by fish) without corrupting the next prompt",
    "columns": 30,
    "config": {
      "theme": "rainbow",
      "rows": [
        { "left": [{ "text": "a-long-left-label-that-overflows" }], "right": [{ "text": "right-one" }, { "padding": 0 }] },
        { "left": ["shell", "cmd"] }
      ]
    },
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      { "snapshot": "prompt" },
      { "run": "echo hi" },
      { "wait": "\\nhi\\n(?s:.*)\\n{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "after",
          "expect": ["\\n{{shell}}[^\\n]*echo hi\\nhi\\n[^\\n]*(a-long|that-overflows)"]
        }
      }
    ]
  },
  {
    "name": "wide-chars",
    "description": "Double-width characters in the path keep the right side flush with the edge",
    "dir": "superline-e2e/日本語/データ",
    "columns": 60,
    "config": {
      "theme": "rainbow",
      "rows": [
        { "left": [{ "cwd": { "max_length": 40, "wanted_seg_num": 2 } }], "right": [{ "text": "edge" }, { "padding": 0 }] },
        { "left": ["shell", "cmd"] }
      ]
    },
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "prompt",
          "expect": ["\\A[^\\n]*データ[^\\n]*edge[^\\n]*\\n{{shell}}{{sep}}{{ok}}"],
          "widths": [{ "line": "edge", "width": "{{columns}} - 1" }]
        }
      }
    ]
  },
  {
    "name": "continuation",
    "description": "A command continued onto a second input line runs, and the next prompt draws below its output",
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      { "run": "echo 'one" },
      { "sleep": "1s" },
      { "run": "two'" },
      { "wait": "\\ntwo\\n(?s:.*)\\n{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "after",
          "expect": ["\\none\\ntwo\\n[^\\n]*superline-e2e[^\\n]*\\n{{shell}}{{sep}}{{ok}}"]
        }
      }
    ]
  },
  {
    "name": "no-newline",
    "description": "Output without a trailing newline does not push the first row off the left edge",
    "xfail": {
      "reason": "bash has no PROMPT_SP equivalent, so the first row starts right after the unterminated output",
      "shells": ["bash"]
    },
    "steps": [
      { "wait": "{{shell}}{{sep}}{{ok}}" },
      {
        "run": {
          "default": "printf partial",
          "pwsh": "Write-Host -NoNewline partial",
          "nu": "print -n partial"
        }
      },
      { "wait": "partial(?s:.*)\\n{{shell}}{{sep}}{{ok}}" },
      {
        "snapshot": {
          "name": "after",
          "expect": ["\\npartial[^\\n]*\\n[^\\n]*superline-e2e[^\\n]*\\n{{shell}}{{sep}}{{ok}}"],
          "reject": ["partial[^\\n]*superline-e2e"]
        }
      }
    ]
  }
]
